# Copy to .env and fill in. NEVER commit .env
# Base URL and model ID from https://dev.meta.ai/docs/quickstart (OpenAI-compatible)
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
# low is fast (~5s per paragraph) for the playground; precompute uses medium.
META_REASONING_EFFORT=low

# Playground protection (apps/web)
PLAYGROUND_ENABLED=true
# Optional. Leave empty for a public playground; when set, live runs require this code.
PLAYGROUND_ACCESS_CODE=
MAX_INPUT_CHARS=1000
RATE_LIMIT_PER_IP=10
RATE_LIMIT_WINDOW_MIN=10
DAILY_LIMIT=300
CACHE_DIR=.cache/annotations
# Every playground run (time, text, result) is appended here as JSON lines.
HISTORY_FILE=.cache/history.jsonl
# Salt for the hashed IP stored with each run.
HISTORY_SALT=
